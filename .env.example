# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (Settings > Database): pooled (Supavisor, port 6543, ?pgbouncer=true) and direct connections
DATABASE_URL=
DIRECT_URL=

# Seed admin (required by `npx prisma db seed`; no defaults. Password: 12+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
