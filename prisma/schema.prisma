generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  EDITOR
  ADMIN
}

model User {
  // Same value as auth.users.id in Supabase Auth
  id                  String    @id
  name                String?
  email               String?   @unique
  image               String?
  role                Role      @default(USER)
  news                News[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model News {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  imageUrl    String?
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  eventDate   DateTime
  location    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  title     String?
  specialty String?
  email     String?
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
